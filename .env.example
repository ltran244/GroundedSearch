# Postgres. DATABASE_PORT is the port published on your machine by
# docker-compose; inside the Compose network the worker uses 5432 and the
# service names instead (see docker-compose.yaml).
DATABASE_HOST=localhost
DATABASE_NAME=groundedsearch
DATABASE_PORT=5433
DATABASE_USER=groundedsearch
DATABASE_PASSWORD=change-me
# Integration tests truncate this database between tests, so keep it separate.
TEST_DATABASE_NAME=groundedsearch_test

REDIS_HOST=localhost
REDIS_PORT=6379

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
